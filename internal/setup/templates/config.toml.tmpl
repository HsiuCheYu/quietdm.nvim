# Generated by `quietdmd setup`. See docs/matrix-setup.md for what every
# field here means, and examples/matrix.toml for the hand-written version of
# the same file.

[transport]
kind = "matrix"

[matrix]
homeserver = "{{.Homeserver}}"
user_id    = "{{.UserID}}"

# The access token never goes in this file. quietdmd setup wrote it here
# instead, with mode 0600 — the daemon refuses to read a token file anybody
# else on the machine can.
token_file = "{{.TokenFile}}"

# Left empty, the daemon asks the homeserver which device the token belongs
# to.
# device_id = ""

# Olm/Megolm, on by default. Every room the bridge creates is encrypted, so
# turning this off means reading nothing at all.
encrypt = true

[aliases]
# The frontend shows the localpart of the sender by default, which already
# reads like a git author name. quietdm setup pre-filled whatever puppet
# display names it could see when it ran; override or add more as you like.
{{range $mxid, $name := .Aliases -}}
"{{$mxid}}" = "{{$name}}"
{{end -}}

[sanitize]
strip_emoji = true
