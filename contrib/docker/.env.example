# Copy to .env and fill in. The file is read by docker compose only; nothing
# here reaches quietdmd.
POSTGRES_PASSWORD=change-me

# Synapse and the bridge chown whatever they generate inside data/ to these
# IDs. `quietdmd setup` fills them in with your own; set them by hand
# (`id -u` / `id -g`) if you follow docs/self-host.md instead. Leaving them
# blank is safe -- compose refuses to start and tells you what to run. Do
# not guess a value: a wrong one means sudo every time you edit
# data/synapse/homeserver.yaml or data/bridge/config.yaml by hand.
QUIETDM_UID=
QUIETDM_GID=
