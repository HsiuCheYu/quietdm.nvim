# Copy to .env and fill in. The file is read by docker compose only; nothing
# here reaches quietdmd.
POSTGRES_PASSWORD=change-me

# Synapse and the bridge chown whatever they generate inside data/ to these
# IDs. Set them to your own (`id -u` / `id -g`), or you'll need sudo every
# time you edit data/synapse/homeserver.yaml or data/bridge/config.yaml by
# hand.
QUIETDM_UID=1000
QUIETDM_GID=1000
